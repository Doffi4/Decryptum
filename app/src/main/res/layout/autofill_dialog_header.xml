<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- Material 3 Drag Handle (must be ImageView for RemoteViews compatibility) -->
    <ImageView
        android:id="@+id/autofill_header_drag_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/bg_autofill_drag_handle"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Compact Row: Favicon + Domain Name + "Сохранённые аккаунты" + Close Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/autofill_header_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_autofill_key"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/autofill_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#F5EFEA"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/autofill_header_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="13sp"
                android:textColor="#BFAFA6"
                android:text="@string/autofill_matching_subtitle"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <ImageView
            android:id="@+id/autofill_header_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_autofill_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel" />

    </LinearLayout>

</LinearLayout>
